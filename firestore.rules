rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Consolidated employee directory (single-document roster for high read/storage efficiency)
    match /directory/{directoryId} {
      allow read, write: if true;
    }

    // Individual employee documents
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Assessments / Fit to Work reports
    match /assessments/{assessmentId} {
      allow read, write: if true;
    }

    // Fallback rule
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
